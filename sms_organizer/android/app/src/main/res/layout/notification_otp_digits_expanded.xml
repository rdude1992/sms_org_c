<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded-state body for an OTP notification (see
  IncomingSmsNotifier.configureOtpNotification / buildOtpExpandedView) — the
  boxed "sent message" bubble on top, then the full raw SMS text below it,
  so pulling the notification down shows the complete message rather than
  just the isolated code. The message text colour is a resource with a
  values-night variant (@color/notification_body_text), not a theme
  attribute: System UI inflates this layout with a default light theme, so
  ?android:attr/textColorSecondary rendered near-black on a dark shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/otp_digits_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/otp_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/notification_body_text"
        android:maxLines="8"
        android:ellipsize="end" />

</LinearLayout>
